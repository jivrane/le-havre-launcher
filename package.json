{
  "name": "le-havre-launcher",
  "version": "1.0.0",
  "description": "Launcher officiel pour le serveur Minecraft Post-Apocalyptique Le Havre",
  "author": "Le Havre",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "fr.lehavre.launcher",
    "productName": "Le Havre Launcher",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Le Havre Launcher"
    }
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "win-ca": "^3.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7"
  }
}
